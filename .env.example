# Neon Postgres connection string (required on Vercel)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Per-person PINs as one-line JSON. Keys must match names in src/lib/people.ts.
# Paste the raw JSON only (no extra quotes around the whole value).
# Leave unset only for local demo (each person gets 1000, 1001, …).
# On Vercel: set this env var, then Redeploy. DB table person_pins only stores later pin changes.
# PERSON_PINS={"سهیل":"1234","پریسا":"2345","فاطمه جودکی":"3456","کاویان":"4567","فاطمه منصوری":"5678","محمد رضا زارع":"6789"}
PERSON_PINS=
